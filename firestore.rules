/**
 * This ruleset enforces a strict user-ownership model for a resume-building application.
 * All user-generated data is private and can only be accessed by the user who created it.
 *
 * Core Philosophy:
 * The security model is built on the principle of least privilege. By default, all access is
 * denied. Rules explicitly grant access only to authenticated users for their own data,
 * preventing any user from seeing or modifying another user's information.
 *
 * Data Structure:
 * The data is organized hierarchically under a top-level `users` collection. Each user's
 * profile (`UserProfile`) is a document at `/users/{userId}`. All other data related to that
 * user, such as their resume data (`ResumeData`), is stored in subcollections under their
 * specific user document (e.g., `/users/{userId}/resumeData/{resumeDataId}`).
 *
 * Key Security Decisions:
 * - Path-Based Ownership: Authorization is primarily determined by matching the authenticated
 *   user's UID (`request.auth.uid`) with the `{userId}` wildcard in the document path.
 * - No Public Data: There are no publicly readable collections. All access requires authentication.
 * - User Privacy: Listing all users from the top-level `/users` collection is explicitly disallowed
 *   to protect user privacy and prevent data scraping.
 * - Strict Data Validation: On create and update, rules validate the shape and type of the
 *   incoming data (`request.resource.data`) to ensure data integrity and prevent malicious or malformed data.
 * - Immutability: On update, key fields like `id` and `userId` are enforced as immutable to
 *   prevent re-associating data with a different user or entity.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ####################
    // ## Helper Functions
    // ####################

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // ####################
    // ## UserProfile Rules
    // ####################

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // CRITICAL: Prevent enumeration of all users.
      allow create: if isOwner(userId)
                      && request.resource.data.id == userId // Enforce internal ID on create
                      && request.resource.data.email == request.auth.token.email; // Email must match token
      allow update: if isOwner(userId)
                      && request.resource.data.id == resource.data.id // ID is immutable
                      && request.resource.data.email == resource.data.email; // Email is immutable

      // ####################
      // ## ResumeData Rules (Subcollection)
      // ####################

      match /resumeData/{resumeDataId} {
        allow get, list: if isOwner(userId);
        
        allow create: if isOwner(userId)
                       && request.resource.data.userId == userId // Enforce ownership link
                       && request.resource.data.id == resumeDataId // Enforce internal ID
                       && request.resource.data.target_job_title is string
                       && request.resource.data.personal_info.full_name is string;

        allow update: if isOwner(userId)
                       && request.resource.data.userId == resource.data.userId // userId is immutable
                       && request.resource.data.id == resource.data.id; // id is immutable

        allow delete: if isOwner(userId);
      }
    }
  }
}
