/**
 * This ruleset is designed for the "AI Resume Builder" application and enforces a strict,
 * user-centric security model. All user-generated content is private.
 *
 * Core Philosophy:
 * - Least Privilege: By default, all access is denied. Rules explicitly grant access.
 * - User Ownership: The primary authorization mechanism is matching the authenticated
 *   user's UID (`request.auth.uid`) with an `ownerId` or document ID.
 * - Flat Hierarchy: Root-level collections are used to avoid deep nesting and simplify rules.
 *
 * Data Structure:
 * - /users/{userId}: Public-facing user profile information.
 * - /resumes/{resumeId}: Core resume documents, owned by a user.
 * - Other collections for subscriptions, payments, etc., with specific access controls.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ####################
    // ## Helper Functions
    // ####################
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ####################
    // ## /users Collection
    // ####################
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Prevent enumeration of all users.
      
      // A user can create their own profile document.
      allow create: if isOwner(userId)
                    && request.resource.data.userId == userId
                    && request.resource.data.email == request.auth.token.email;
      
      // A user can update their own profile, but cannot change their email or userId.
      allow update: if isOwner(userId)
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.userId == resource.data.userId;
    }

    // ####################
    // ## /resumes Collection
    // ####################
    match /resumes/{resumeId} {
      // Allow read/delete only if the user is the owner of the document.
      allow get, delete: if isOwner(resource.data.ownerId);

      // Allow listing resumes only for queries that filter by the user's own `ownerId`.
      allow list: if isSignedIn() && request.query.resource.data.ownerId == request.auth.uid;
      
      // Allow creating a resume if the user is signed in and sets themselves as the owner.
      // Validate required fields on creation.
      allow create: if isOwner(request.resource.data.ownerId)
                    && request.resource.data.resumeId == resumeId
                    && request.resource.data.title is string
                    && request.resource.data.templateId is string;

      // Allow updating a resume if the user is the owner.
      // Critical fields like ownerId and resumeId are immutable.
      allow update: if isOwner(resource.data.ownerId)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.resumeId == resource.data.resumeId;
    }

    // ####################
    // ## Read-Only Collections
    // ####################
    
    // Templates are public and read-only for all users.
    match /templates/{templateId} {
      allow get: if true;
      allow write: if false; // No one can write to templates.
    }

    // Global app config is public and read-only.
    match /appConfig/global {
        allow get: if true;
        allow write: if false; // Only modifiable from the Firebase Console.
    }

    // ####################
    // ## Restricted Collections
    // ####################

    // Subscriptions are read-only for the owner.
    match /subscriptions/{userId} {
        allow get: if isOwner(userId);
        allow write: if false; // Writes should only happen from a trusted backend server.
    }

    // All other collections are locked down by default.
    // (resumeVersions, payments, aiRequests, appLogs)
    match /{collection}/{docId} {
      allow read, write: if false;
    }
  }
}