/**
 * This ruleset is designed for the "AI Resume Builder" application and enforces a strict,
 * user-centric security model. All user-generated content is private.
 *
 * Core Philosophy:
 * - Least Privilege: By default, all access is denied. Rules explicitly grant access.
 * - User Ownership: The primary authorization mechanism is matching the authenticated
 *   user's UID (`request.auth.uid`) with an `ownerId` or document ID.
 * - Nested Data: User-specific data like resumes are stored in subcollections under the user's document.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ####################
    // ## Helper Functions
    // ####################
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ####################
    // ## /users Collection
    // ####################
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Prevent enumeration of all users.
      
      // A user can create their own profile document.
      allow create: if isOwner(userId)
                    && request.resource.data.userId == userId
                    && request.resource.data.email == request.auth.token.email;
      
      // A user can update their own profile, but cannot change their email or userId.
      allow update: if isOwner(userId)
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.userId == resource.data.userId;
      
      // ####################
      // ## /users/{userId}/resumes Subcollection
      // ####################
      match /resumes/{resumeId} {
        // A user can perform any operation on a resume within their own document.
        allow read, write, delete: if isOwner(userId);
      }
    }

    // ####################
    // ## Read-Only Collections
    // ####################
    
    // Templates are public and read-only for all users.
    match /templates/{templateId} {
      allow get: if true;
      allow write: if false; // No one can write to templates.
    }

    // Global app config is public and read-only.
    match /appConfig/global {
        allow get: if true;
        allow write: if false; // Only modifiable from the Firebase Console.
    }

    // ####################
    // ## Restricted Collections
    // ####################

    // Subscriptions are read-only for the owner.
    match /subscriptions/{userId} {
        allow get: if isOwner(userId);
        allow write: if false; // Writes should only happen from a trusted backend server.
    }

    // All other root collections are locked down by default.
    // This now implicitly includes the old /resumes collection.
    match /{collection}/{docId} {
      allow read, write: if false;
    }
  }
}
