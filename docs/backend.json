{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "description": "Stores authentication-linked user profile data, preferences, onboarding progress, and plan status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Matches Firebase Auth UID." },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": ["string", "null"], "format": "uri" },
        "plan": { "type": "string", "enum": ["free", "pro", "premium"] },
        "onboardingStep": { "type": "number" },
        "preferences": {
          "type": "object",
          "properties": {
            "theme": { "type": "string", "enum": ["hud", "light", "dark"] },
            "language": { "type": "string" },
            "notifications": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "displayName", "plan", "createdAt", "updatedAt"]
    },
    "Resume": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Resume",
      "description": "Each resume is a standalone project owned by a user. Optimized for editing, versioning, and AI augmentation.",
      "type": "object",
      "properties": {
        "resumeId": { "type": "string" },
        "ownerId": { "type": "string", "description": "Foreign key to the users collection." },
        "title": { "type": "string" },
        "templateId": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "completed"] },
        "sections": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "object",
              "properties": { "content": { "type": "string" }, "lastEdited": { "type": "string", "format": "date-time" } }
            },
            "experience": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "company": { "type": "string" },
                  "role": { "type": "string" },
                  "startDate": { "type": "string", "format": "date-time" },
                  "endDate": { "type": ["string", "null"], "format": "date-time" },
                  "bullets": { "type": "array", "items": { "type": "string" } },
                  "order": { "type": "number" }
                }
              }
            },
            "education": { "type": "array", "items": { "type": "object" } },
            "skills": { "type": "array", "items": { "type": "string" } }
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "fontSize": { "type": "number" },
            "spacing": { "type": "string", "enum": ["normal", "compact"] }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["resumeId", "ownerId", "title", "templateId", "status", "sections", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "User", "schema": { "$ref": "#/entities/User" } } },
      { "path": "/resumes/{resumeId}", "definition": { "entityName": "Resume", "schema": { "$ref": "#/entities/Resume" } } },
      { "path": "/resumeVersions/{versionId}", "description": "Immutable snapshots of resume states for undo, restore, and AI comparison." },
      { "path": "/subscriptions/{userId}", "description": "Tracks paid plans, feature access, and Stripe metadata." },
      { "path": "/payments/{paymentId}", "description": "Audit trail for all payments." },
      { "path": "/aiRequests/{requestId}", "description": "Logs AI interactions for debugging, analytics, and quality control." },
      { "path": "/templates/{templateId}", "description": "Stores predefined resume templates." },
      { "path": "/appConfig/global", "description": "Global application configuration and feature flags." }
    ],
    "reasoning": "This Firestore structure uses root-level collections to maintain a shallow data hierarchy, which is optimal for performance and security rule simplicity. Relationships are managed via stored IDs (e.g., `ownerId` in resumes) rather than deep nesting, following Firebase-recommended patterns. This design is scalable, secure, and supports efficient querying for the application's primary use cases."
  }
}